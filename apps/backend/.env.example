# Copy to .env and fill in. Never commit .env.
# Secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Postgres: create an empty UTF-8 database for Medusa first (separate from the Strapi one).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/safonix_commerce
# Medusa switches SSL on in production; keep false for a local or same-network Postgres.
DATABASE_SSL=false

# Redis is optional in development and needed in production (events and workflows).
# REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me
COOKIE_SECRET=change_me

# Who may call the API from a browser: the storefront, and the admin dashboard itself.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
