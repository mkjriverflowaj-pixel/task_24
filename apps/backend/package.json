{
  "name": "@safonix/backend",
  "version": "0.0.1",
  "description": "Safonix commerce backend (Medusa v2): products, cart, orders, payments.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed-store.ts",
    "user:create": "medusa user",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "import:products": "medusa exec ./src/scripts/import-strapi-products.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/caching": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/draft-order": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@tanstack/react-query": "5.107.1",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "scrypt-kdf": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.23.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
