# Copy to .env.local and adjust.
STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Products come from Medusa (apps/backend). The key is the "Safonix Storefront" publishable key:
# Medusa admin > Settings > Publishable API Keys (or the line printed by `npm run seed` in apps/backend).
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
