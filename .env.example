# Copy to .env (docker compose reads it). Never commit .env.

# Medusa's "Safonix Storefront" publishable key (a public key): Medusa admin > Settings > Publishable API Keys,
# or the line printed by `npm run seed` in apps/backend.
MEDUSA_PUBLISHABLE_KEY=

# The PostgreSQL server that holds both databases (safonix for Strapi, safonix_commerce for Medusa).
# Use the same user and password as DATABASE_USERNAME / DATABASE_PASSWORD in apps/cms/.env.
POSTGRES_USER=safonix_app
POSTGRES_PASSWORD=

# Optional. The defaults suit Docker Desktop, with Strapi and Medusa reachable on this computer's ports.
# WEB_STRAPI_URL=http://host.docker.internal:1337
# WEB_MEDUSA_URL=http://host.docker.internal:9000
# STRAPI_PUBLIC_URL=http://localhost:1337
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_IMAGE_UNOPTIMIZED=true
